# sops configuration for secrets encryption
# Copy this to ~/.secrets/.sops.yaml and replace placeholder keys
# with your actual age public keys (one per machine).
#
# After adding a new key, re-encrypt existing files:
#   sops updatekeys ~/.secrets/env/global.env

creation_rules:
  - path_regex: \.env$
    age: >-
      age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,
      age1yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
