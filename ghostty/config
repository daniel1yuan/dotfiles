# @file: Ghostty Terminal Configuration File
# @author: Daniel Yuan (daniel1yuan@gmail.com)

# Other config
# scrollback-limit is in bytes (~10MB roughly matches kitty's 5000 lines)
scrollback-limit = 10000000
confirm-close-surface = false

# Colors: Catppuccin Mocha (built into ghostty)
theme = Catppuccin Mocha

# Font: Requires NerdFont installation
font-family = JetBrainsMono Nerd Font Mono

# Key Bindings
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+l=clear_screen

# Split Navigation (hjkl)
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

# Tab Bindings
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
